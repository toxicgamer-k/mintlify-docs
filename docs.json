{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Chirper",
  "description": "The Social Media Platform Built Directly Into Discord.",
  "colors": {
    "primary": "#FF4A1C",
    "light": "#FF4A1C",
    "dark": "#C3350F"
  },
  "background": {
    "color": {
      "light": "#F3EFE8",
      "dark": "#111112"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter Tight",
      "weight": 700
    },
    "body": {
      "family": "Geist",
      "source": "/fonts/geist-latin.woff2",
      "format": "woff2"
    }
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navigation": {
    "groups": [
      {
        "group": "Home",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Getting Started",
        "pages": [
          "getting-started"
        ]
      },
      {
        "group": "Features",
        "pages": [
          "features/overview",
          "features/internet",
          "features/marketplace",
          "features/account-management"
        ]
      },
      {
        "group": "Commands",
        "pages": [
          "commands/overview"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Invite Chirper",
      "href": "https://discord.com/oauth2/authorize?client_id=1533344680807497900"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  }
}
